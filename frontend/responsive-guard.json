{
  "baseUrl": "http://127.0.0.1:4287",
  "sesion": "qa/observabilidad/sesion-ficticia.json",
  "servidor": {
    "comando": "node qa/observabilidad/servidor.mjs"
  },
  "rutas": [
    {
      "path": "/admin/dashboard",
      "esperar": "app-tablero-operacion ui-heatmap",
      "archivos": [
        "src/app/features/panels/admin/pages/dashboard/**",
        "src/app/features/panels/admin/ui/**",
        "src/app/shared/ui/charts/heatmap.ts",
        "src/app/shared/ui/charts/line-chart.ts"
      ],
      "estados": [
        {
          "nombre": "periodo-30-dias",
          "pasos": [
            {
              "scroll": "app-tablero-operacion app-selector-periodo"
            },
            {
              "click": "app-tablero-operacion app-selector-periodo .ui-rango__btn:last-child"
            },
            {
              "waitFor": "app-tablero-operacion ui-heatmap"
            },
            {
              "wait": 500
            }
          ]
        }
      ]
    },
    {
      "path": "/admin/monitoreo",
      "esperar": "app-admin-monitoreo .ui-table",
      "archivos": [
        "src/app/features/panels/admin/pages/monitoreo/**",
        "src/app/features/panels/admin/pages/_observabilidad.scss",
        "src/app/features/panels/admin/ui/**"
      ],
      "estados": [
        {
          "nombre": "fuera-de-meta",
          "pasos": [
            {
              "click": "app-admin-monitoreo .toolbar button[aria-pressed]"
            },
            {
              "waitFor": "app-admin-monitoreo .ui-table"
            }
          ]
        },
        {
          "nombre": "detalle-api",
          "pasos": [
            {
              "scroll": "app-admin-monitoreo .row-actions button"
            },
            {
              "click": "app-admin-monitoreo .row-actions button"
            },
            {
              "waitFor": "ui-modal .ui-table"
            },
            {
              "wait": 400
            }
          ]
        },
        {
          "nombre": "busqueda-sin-resultados",
          "pasos": [
            {
              "fill": [
                "app-admin-monitoreo input[type=search]",
                "no-existe"
              ]
            },
            {
              "waitFor": "app-admin-monitoreo ui-empty"
            }
          ]
        }
      ]
    },
    {
      "path": "/admin/actividad",
      "esperar": "app-admin-actividad .ui-table",
      "archivos": [
        "src/app/features/panels/admin/pages/actividad/**",
        "src/app/features/panels/admin/pages/_observabilidad.scss",
        "src/app/features/panels/admin/ui/**"
      ],
      "estados": [
        {
          "nombre": "filtros-abiertos",
          "pasos": [
            {
              "click": "button[aria-controls=actividad-filtros]"
            },
            {
              "waitFor": "#actividad-usuario"
            },
            {
              "wait": 400
            }
          ]
        },
        {
          "nombre": "vacio",
          "pasos": [
            {
              "click": "button[aria-controls=actividad-filtros]"
            },
            {
              "waitFor": ".ui-panel-filtros--abierto"
            },
            {
              "wait": 500
            },
            {
              "fill": [
                "#actividad-usuario",
                "sin-datos"
              ]
            },
            {
              "press": "Enter"
            },
            {
              "waitFor": "app-admin-actividad ui-empty"
            },
            {
              "click": ".ui-panel-filtros__pie .ui-btn--accent"
            },
            {
              "waitFor": "app-admin-actividad ui-empty"
            },
            {
              "wait": 400
            }
          ]
        },
        {
          "nombre": "pagina-siguiente",
          "pasos": [
            {
              "scroll": "app-paginador-cursor"
            },
            {
              "click": "app-paginador-cursor .ui-paginador__btn:last-child"
            },
            {
              "waitFor": "app-admin-actividad .ui-table"
            }
          ]
        },
        {
          "nombre": "error",
          "pasos": [
            {
              "click": "button[aria-controls=actividad-filtros]"
            },
            {
              "waitFor": ".ui-panel-filtros--abierto"
            },
            {
              "wait": 500
            },
            {
              "fill": [
                "#actividad-usuario",
                "fallo"
              ]
            },
            {
              "press": "Enter"
            },
            {
              "waitFor": "app-admin-actividad ui-empty"
            },
            {
              "click": ".ui-panel-filtros__pie .ui-btn--accent"
            },
            {
              "waitFor": "app-admin-actividad ui-empty"
            },
            {
              "wait": 400
            }
          ]
        }
      ]
    },
    {
      "path": "/admin/auditoria",
      "esperar": "app-admin-auditoria .ui-table",
      "archivos": [
        "src/app/features/panels/admin/pages/auditoria/**",
        "src/app/features/panels/admin/pages/_observabilidad.scss",
        "src/app/features/panels/admin/ui/**"
      ],
      "estados": [
        {
          "nombre": "filtros-abiertos",
          "pasos": [
            {
              "click": "button[aria-controls=auditoria-filtros]"
            },
            {
              "waitFor": "#auditoria-registro"
            },
            {
              "wait": 400
            }
          ]
        },
        {
          "nombre": "vacio",
          "pasos": [
            {
              "click": "button[aria-controls=auditoria-filtros]"
            },
            {
              "waitFor": ".ui-panel-filtros--abierto"
            },
            {
              "wait": 500
            },
            {
              "fill": [
                "#auditoria-usuario",
                "sin-datos"
              ]
            },
            {
              "press": "Enter"
            },
            {
              "waitFor": "app-admin-auditoria ui-empty"
            },
            {
              "click": ".ui-panel-filtros__pie .ui-btn--accent"
            },
            {
              "waitFor": "app-admin-auditoria ui-empty"
            },
            {
              "wait": 400
            }
          ]
        }
      ]
    }
  ],
  "ignorarSelectores": [
    "[data-responsive-ignore]",
    "aside#shell-nav[inert]",
    ".ui-panel-filtros__panel[inert]",
    ".ui-panel-filtros__overlay",
    ".ui-search > ui-icon",
    ".u-sr-only",
    "ui-gauge .gauge__center"
  ]
}
